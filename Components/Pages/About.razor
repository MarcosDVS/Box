@page "/about"

<PageTitle>Acerca de BOX</PageTitle>

<div class="box-about-page">

<!-- ============================================== -->
<!-- ENCABEZADO -->
<!-- ============================================== -->

<div class="box-about-header">

    <div class="box-version-icon">
        B
    </div>

    <div>
        <h1 class="mb-1 fw-bold">
            BOX
        </h1>

        <p class="mb-2 text-muted">
            Sistema de gestión y facturación
        </p>

        <span class="box-version-badge">
            Versión 5.0
        </span>
    </div>

</div>


<!-- ============================================== -->
<!-- DESCRIPCIÓN -->
<!-- ============================================== -->

<div class="box-about-section">

    <div class="box-section-title">
        <i class="bi bi-info-circle"></i>

        <h4>Acerca del sistema</h4>
    </div>

    <p class="text-muted mb-0">
        BOX es un sistema de gestión empresarial diseñado para facilitar
        la administración de las operaciones comerciales, permitiendo
        gestionar clientes, proveedores, productos, ventas y facturación
        desde una plataforma centralizada.
    </p>

</div>


<!-- ============================================== -->
<!-- FUNCIONES -->
<!-- ============================================== -->

<div class="box-about-section">

    <div class="box-section-title">

        <i class="bi bi-grid"></i>

        <h4>Funcionalidades</h4>

    </div>


    <div class="row g-3">

        <div class="col-md-6">

            <div class="box-feature">

                <div class="box-feature-icon">
                    👥
                </div>

                <div>
                    <strong>Gestión de clientes</strong>

                    <p>
                        Registro y administración de la información
                        de los clientes.
                    </p>
                </div>

            </div>

        </div>


        <div class="col-md-6">

            <div class="box-feature">

                <div class="box-feature-icon">
                    📦
                </div>

                <div>

                    <strong>Gestión de productos</strong>

                    <p>
                        Control de productos y categorías
                        disponibles en el sistema.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-6">

            <div class="box-feature">

                <div class="box-feature-icon">
                    🧾
                </div>

                <div>

                    <strong>Facturación</strong>

                    <p>
                        Registro y control de ventas al contado
                        y ventas a crédito.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-6">

            <div class="box-feature">

                <div class="box-feature-icon">
                    💰
                </div>

                <div>

                    <strong>Control de pagos</strong>

                    <p>
                        Gestión de pagos y abonos realizados
                        sobre facturas pendientes.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-6">

            <div class="box-feature">

                <div class="box-feature-icon">
                    🏪
                </div>

                <div>

                    <strong>Control de caja</strong>

                    <p>
                        Seguimiento de movimientos y cuadre
                        de caja.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-6">

            <div class="box-feature">

                <div class="box-feature-icon">
                    🚚
                </div>

                <div>

                    <strong>Gestión de proveedores</strong>

                    <p>
                        Administración de proveedores y
                        relaciones comerciales.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ============================================== -->
<!-- DESARROLLADOR -->
<!-- ============================================== -->

<div class="box-about-section">

    <div class="box-section-title">

        <i class="bi bi-code-slash"></i>

        <h4>Desarrollado por</h4>

    </div>


    <div class="box-developers">

        <!-- DESARROLLADOR 1 -->

        <div class="box-developer">

            <img src="you.jpeg"
                alt="Marcos De Vargas S."
                class="box-developer-image" />

            <div>

                <h5 class="mb-1 fw-bold">
                    Marcos De Vargas S.
                </h5>

                <p class="text-muted mb-0">
                    Desarrollo y programación
                </p>

            </div>

        </div>


        <!-- DESARROLLADOR 2 -->

        <div class="box-developer">

            <img src="bronco.png"
                alt="Bronco Analytics"
                class="box-developer-image" />

            <div>

                <h5 class="mb-1 fw-bold">
                    Bronco Analytics
                </h5>

                <p class="text-muted mb-0">
                    Diseño y desarrollo de software
                </p>

            </div>

        </div>

    </div>

</div>


<!-- ============================================== -->
<!-- CONTACTO -->
<!-- ============================================== -->

<div class="box-about-section">

    <div class="box-section-title">

        <i class="bi bi-person-lines-fill"></i>

        <h4>Información de contacto</h4>

    </div>


    <div class="row g-3">

        <!-- TELÉFONO -->

        <div class="col-md-4">

            <div class="box-contact-item">

                <i class="bi bi-telephone"></i>

                <div>

                    <small>Teléfono</small>

                    <strong>
                        +1 (829) 870-7794
                    </strong>

                </div>

            </div>

        </div>


        <!-- CORREO -->

        <div class="col-md-4">

            <div class="box-contact-item">

                <i class="bi bi-envelope"></i>

                <div>

                    <small>Correo electrónico</small>

                    <strong>
                        elbroncotech@hotmail.com
                    </strong>

                </div>

            </div>

        </div>


        <!-- INSTAGRAM -->

        <div class="col-md-4">

            <a href="https://www.instagram.com/broncoanalytics/"
               target="_blank"
               rel="noopener noreferrer"
               class="box-contact-item text-decoration-none">

                <i class="bi bi-instagram"></i>

                <div>

                    <small>Instagram</small>

                    <strong>
                        @@broncoanalytics
                    </strong>

                </div>

            </a>

        </div>

    </div>

</div>


<!-- ============================================== -->
<!-- CRÉDITOS -->
<!-- ============================================== -->

<div class="box-about-section">

    <div class="box-section-title">

        <i class="bi bi-heart"></i>

        <h4>Créditos y agradecimientos</h4>

    </div>

    <p class="text-muted mb-0">

        Agradezco al Lic. Félix Benzan y a la Lic. Jennifer Karina
        Disla Vásquez por compartir sus conocimientos y contribuir
        a mi formación profesional. También agradezco a todos los
        colegas que colaboraron durante el desarrollo de este proyecto
        y a las herramientas que facilitaron el proceso de desarrollo
        y resolución de problemas técnicos.

    </p>

</div>


<!-- ============================================== -->
<!-- PIE -->
<!-- ============================================== -->

<div class="box-about-footer">

    <strong>BOX 5.0</strong>

    <span>•</span>

    <span>Sistema de gestión empresarial</span>

</div>

</div>

<style>

    /* ============================================== */
    /* PÁGINA PRINCIPAL */
    /* ============================================== */

    .box-about-page {

        max-width: 1000px;

        margin: 0 auto;

        padding: 30px 20px 50px;

    }


    /* ============================================== */
    /* ENCABEZADO */
    /* ============================================== */

    .box-about-header {

        display: flex;

        align-items: center;

        gap: 18px;

        padding: 25px;

        margin-bottom: 25px;

        background: white;

        border: 1px solid #e9ecef;

        border-radius: 14px;

        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);

    }


    .box-version-icon {

        width: 65px;

        height: 65px;

        display: flex;

        align-items: center;

        justify-content: center;

        background: #212529;

        color: white;

        border-radius: 14px;

        font-size: 30px;

        font-weight: 700;

    }


    .box-about-header h1 {

        letter-spacing: 2px;

    }


    .box-version-badge {

        display: inline-block;

        padding: 5px 12px;

        background: #212529;

        color: white;

        border-radius: 20px;

        font-size: 12px;

        font-weight: 600;

    }


    /* ============================================== */
    /* SECCIONES */
    /* ============================================== */

    .box-about-section {

        background: white;

        border: 1px solid #e9ecef;

        border-radius: 12px;

        padding: 25px;

        margin-bottom: 20px;

    }


    .box-section-title {

        display: flex;

        align-items: center;

        gap: 10px;

        margin-bottom: 20px;

        padding-bottom: 12px;

        border-bottom: 1px solid #e9ecef;

    }


    .box-section-title i {

        font-size: 20px;

        color: #212529;

    }


    .box-section-title h4 {

        margin: 0;

        font-weight: 700;

    }


    /* ============================================== */
    /* FUNCIONALIDADES */
    /* ============================================== */

    .box-feature {

        display: flex;

        gap: 15px;

        padding: 16px;

        height: 100%;

        border: 1px solid #e9ecef;

        border-radius: 10px;

        transition: 0.2s;

    }


    .box-feature:hover {

        transform: translateY(-2px);

        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.06);

    }


    .box-feature-icon {

        width: 42px;

        height: 42px;

        flex-shrink: 0;

        display: flex;

        align-items: center;

        justify-content: center;

        background: #f1f3f5;

        border-radius: 10px;

        font-size: 20px;

    }


    .box-feature strong {

        display: block;

        margin-bottom: 5px;

    }


    .box-feature p {

        margin: 0;

        color: #6c757d;

        font-size: 14px;

    }


    /* ============================================== */
    /* DESARROLLADOR */
    /* ============================================== */

    .box-developer {

        display: flex;

        align-items: center;

        gap: 15px;

    }


    .box-developer-image {

        width: 65px;

        height: 65px;

        object-fit: cover;

        border-radius: 50%;

        border: 3px solid #f1f3f5;

    }


    /* ============================================== */
    /* CONTACTO */
    /* ============================================== */

    .box-contact-item {

        display: flex;

        align-items: center;

        gap: 15px;

        padding: 15px;

        background: #f8f9fa;

        border-radius: 10px;

    }


    .box-contact-item > i {

        font-size: 22px;

    }


    .box-contact-item small {

        display: block;

        color: #6c757d;

        margin-bottom: 3px;

    }


    .box-contact-item strong {

        display: block;

        font-size: 14px;

        word-break: break-word;

    }


    /* ============================================== */
    /* PIE */
    /* ============================================== */

    .box-about-footer {

        display: flex;

        justify-content: center;

        align-items: center;

        gap: 8px;

        color: #6c757d;

        font-size: 13px;

        padding-top: 10px;

    }


    /* ============================================== */
    /* PANTALLAS PEQUEÑAS */
    /* ============================================== */

    @@media (max-width: 576px) {

        .box-about-page {

            padding: 20px 15px 30px;

        }


        .box-about-header {

            padding: 20px;

        }


        .box-about-section {

            padding: 20px;

        }


        .box-about-footer {

            flex-direction: column;

        }

    }

    .box-developers {

        display: grid;

        grid-template-columns: repeat(2, 1fr);

        gap: 15px;

    }


    .box-developer {

        display: flex;

        align-items: center;

        gap: 15px;

        padding: 15px;

        border: 1px solid #e9ecef;

        border-radius: 10px;

    }


    .box-developer-image {

        width: 65px;

        height: 65px;

        object-fit: cover;

        border-radius: 50%;

        border: 3px solid #f1f3f5;

    }


    @@media (max-width: 576px) {

        .box-developers {

            grid-template-columns: 1fr;

        }

    }

</style>
