@page "/cuadre"
@attribute [Authorize]

<style>
    /* Estilo para el contenedor de la tabla */
    .table-container {
        margin-top: 20px;
    }

    /* Estilo para el cuerpo de la tarjeta */
    .card-body {
        padding: 20px;
    }

    /* Estilo para centrar el texto en las celdas de la tabla */
    .table th, .table td {
        text-align: center;
    }
</style>



<div class="row">
    <div class="col-12">
        <h1 class="d-none d-print-block text-center">Listado de cuadres</h1>
    </div>
</div>


@if (showCard)
{
    <div class="card col-12">
            <div>
                <div class="card-header">
                    <h5 class="title d-print-none text-uppercase"><b>@TituloForm</b></h5>
                    <h5 class="title text-dark d-none d-print-block"><b>Detalles del Cuadre</b></h5>
                </div>

                <EditForm Model="request" OnValidSubmit="Send">

                    <div class="card-body py-3">

                        <!-- RESUMEN DE CAJA -->
                        <div class="row g-2 mb-3">

                            <!-- CAJERO -->
                            <div class="col-md-4">
                                <div class="border rounded px-3 py-2 h-100">
                                    <small class="text-muted d-block">
                                        👤 Cajero
                                    </small>

                                    @if (request.Id > 0)
                                    {
                                        <select class="form-select form-select-sm"
                                                required
                                                @bind="request.CajeroId">

                                            <option disabled selected value="">
                                                Selecciona un cajero
                                            </option>

                                            @foreach (var item in Cajeros)
                                            {
                                                <option value="@item.Id">
                                                    @item.Nombre @item.Apellidos
                                                </option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <strong>@Cashier</strong>
                                    }
                                </div>
                            </div>


                            <!-- DINERO EN CAJA -->
                            <div class="col-md-4">
                                <div class="border rounded px-3 py-2 h-100">
                                    <small class="text-muted d-block">
                                        💰 Dinero en caja
                                    </small>

                                    @if (request.Id > 0)
                                    {
                                        <strong class="fs-5">
                                            $@request.Monto.ToString("N2")
                                        </strong>
                                    }
                                    else
                                    {
                                        <strong class="fs-5">
                                            $@DineroEnCaja.ToString("N2")
                                        </strong>
                                    }
                                </div>
                            </div>


                            <!-- MONTO CUADRADO -->
                            <div class="col-md-4">
                                <div class="border rounded px-3 py-2 h-100">
                                    <small class="text-muted d-block">
                                        🧾 Monto cuadrado
                                    </small>

                                    @if (request.Id > 0)
                                    {
                                        <strong class="fs-5 @(GetTotalClass(request.Total))">
                                            $@request.Total.ToString("N2")
                                        </strong>
                                    }
                                    else
                                    {
                                        <strong class="fs-5 @(GetTotalClass2(request.Total, DineroEnCaja))">
                                            $@request.Total.ToString("N2")
                                        </strong>
                                    }
                                </div>
                            </div>

                        </div>


                        <!-- CONTEO DE EFECTIVO -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <strong>💵 Conteo de efectivo</strong>
                                <small class="text-muted ms-2">
                                    Ingresa la cantidad de billetes.
                                </small>
                            </div>
                        </div>


                        <!-- BILLETES -->
                        <div class="row g-2">

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$1</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.One"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$5</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.Five"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$10</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.Ten"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$25</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.TwentyFive"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$50</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.Fifty"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>


                        </div>

                        <div class="row g-2">
                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$100</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.OneHundred"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$200</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.TwoHundred"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$500</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.FiveHundred"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$1,000</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.OneThousand"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$2,000</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.TwoThousand"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                        </div>

                        <!-- RESULTADO -->
                        <div class="row g-2 mt-3 align-items-center">

                            <div class="col-md-8">
                                <div class="border rounded px-3 py-2 d-flex justify-content-between align-items-center bg-light">

                                    <strong>
                                        📊 Diferencia de caja
                                    </strong>

                                    @if (request.Id > 0)
                                    {
                                        <strong class="fs-5 @(GetTotalClass(request.Total))">
                                            $@((request.Total - request.Monto).ToString("N2"))
                                        </strong>
                                    }
                                    else
                                    {
                                        <strong class="fs-5 @(GetTotalClass2(request.Total, DineroEnCaja))">
                                            $@((request.Total - request.Monto).ToString("N2"))
                                        </strong>
                                    }

                                </div>
                            </div>


                            <!-- BOTONES -->
                            <div class="col-md-4">
                                <div class="d-flex justify-content-end gap-2">

                                    <button type="submit"
                                            class="btn btn-success btn-sm px-4">
                                        💾 Guardar
                                    </button>

                                    <button type="button"
                                            class="btn btn-secondary btn-sm px-4"
                                            @onclick="Clear">
                                        ❌ Cerrar
                                    </button>

                                </div>
                            </div>

                        </div>

                    </div>

                </EditForm>

                
            </div>
    </div>
}
else
{
    <div class="container-fluid py-3">

        <!-- ================================================= -->
        <!-- BARRA DE ACCIONES -->
        <!-- ================================================= -->

        <div class="card border-0 shadow-sm mb-3 d-print-none">

            <div class="card-body">

                <div class="row g-2">

                    <!-- BUSCADOR -->

                    <div class="col-12 col-lg-5">

                        <label class="form-label small text-muted mb-1">
                            Buscar
                        </label>

                        <div class="input-group">

                            <input type="text"
                                class="form-control"
                                placeholder="Buscar arqueo..."
                                @bind="Filtro" />

                            <button class="btn btn-outline-secondary"
                                    type="button"
                                    @onclick="CargarCajas">

                                <i class="bi bi-search"></i>

                            </button>

                        </div>

                    </div>


                    <!-- AÑO -->

                    <div class="col-12 col-sm-6 col-lg-3">

                        <label class="form-label small text-muted mb-1">
                            Año
                        </label>

                        <select class="form-select"
                                @bind="FiltroAno"
                                @bind:after="FiltrarCajas">

                            <option value="">Todos los años</option>

                            @foreach (var ano in AnosDisponibles)
                            {
                                <option value="@ano">
                                    @ano
                                </option>
                            }

                        </select>

                    </div>


                    <!-- MES -->

                    <div class="col-12 col-sm-6 col-lg-3">

                        <label class="form-label small text-muted mb-1">
                            Mes
                        </label>

                        <select class="form-select"
                                @bind="FiltroMes"
                                @bind:after="FiltrarCajas">

                            <option value="">Todos los meses</option>

                            <option value="1">Enero</option>
                            <option value="2">Febrero</option>
                            <option value="3">Marzo</option>
                            <option value="4">Abril</option>
                            <option value="5">Mayo</option>
                            <option value="6">Junio</option>
                            <option value="7">Julio</option>
                            <option value="8">Agosto</option>
                            <option value="9">Septiembre</option>
                            <option value="10">Octubre</option>
                            <option value="11">Noviembre</option>
                            <option value="12">Diciembre</option>

                        </select>

                    </div>


                    <!-- LIMPIAR -->

                    <div class="col-12 col-lg-1 d-flex align-items-end">

                        <button class="btn btn-outline-secondary w-100"
                                title="Limpiar filtros"
                                @onclick="LimpiarFiltros">

                            <i class="bi bi-arrow-counterclockwise"></i>

                            <span class="d-lg-none ms-2">
                                Limpiar filtros
                            </span>

                        </button>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- CONTENIDO -->
        <!-- ================================================= -->

        @if (Cajas.Count == 0)
        {
            <div class="card border-0 shadow-sm">

                <div class="card-body text-center py-5">

                    <div class="display-4 mb-3">
                        🏦
                    </div>

                    <h5 class="text-muted">
                        No hay cajas registradas
                    </h5>

                    <p class="text-muted mb-0">
                        Aún no se han realizado arqueos de caja.
                    </p>

                </div>

            </div>
        }
        else
        {

            <!-- ================================================= -->
            <!-- CARDS PARA PANTALLA -->
            <!-- ================================================= -->

            <div class="row g-3 d-print-none">

                @foreach (var item in CajasFiltradas)
                {
                    var diferencia = item.MontoCuadrado - item.Monto;

                    <div class="col-12 col-md-6 col-xl-4">

                        <div class="card border-0 shadow-sm h-100">

                            <!-- ================================================= -->
                            <!-- ENCABEZADO -->
                            <!-- ================================================= -->

                            <div class="card-header bg-white border-0 pt-3">

                                <div class="d-flex justify-content-between
                                            align-items-start">

                                    <div>

                                        <div class="fw-bold">

                                            <i class="bi bi-calendar3 me-2"></i>

                                            @item.Fecha.ToString("dd/MM/yyyy")

                                        </div>

                                        <small class="text-muted">

                                            @item.Fecha.ToString("hh:mm tt")

                                        </small>

                                    </div>


                                    <!-- RESULTADO -->

                                    @if (diferencia < 0)
                                    {
                                        <span class="badge bg-danger">

                                            <i class="bi bi-arrow-down-circle me-1"></i>

                                            Faltante

                                        </span>
                                    }
                                    else if (diferencia > 0)
                                    {
                                        <span class="badge bg-warning text-dark">

                                            <i class="bi bi-arrow-up-circle me-1"></i>

                                            Sobrante

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Cuadrada

                                        </span>
                                    }

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- CAJERO -->
                            <!-- ================================================= -->

                            <div class="card-body pt-2">

                                <div class="d-flex align-items-center mb-3">

                                    <div class="rounded-circle bg-light border
                                                d-flex align-items-center
                                                justify-content-center
                                                me-2"
                                        style="width: 42px; height: 42px;">

                                        <i class="bi bi-person-fill"></i>

                                    </div>

                                    <div>

                                        <div class="fw-semibold">

                                            @item.Cashier.Nombre
                                            @item.Cashier.Apellidos

                                        </div>

                                        <small class="text-muted">

                                            Cajero

                                        </small>

                                    </div>

                                </div>


                                <!-- ================================================= -->
                                <!-- MOVIMIENTOS -->
                                <!-- ================================================= -->

                                <div class="border-top pt-3">

                                    <h6 class="fw-bold mb-3">

                                        <i class="bi bi-arrow-left-right me-2"></i>

                                        Movimientos

                                    </h6>


                                    <div class="d-flex justify-content-between mb-2">

                                        <span class="text-muted">
                                            Venta a crédito
                                        </span>

                                        <strong>
                                            $@item.VentaCredito.ToString("N2")
                                        </strong>

                                    </div>


                                    <div class="d-flex justify-content-between mb-2">

                                        <span class="text-muted">
                                            Venta al contado
                                        </span>

                                        <strong>
                                            $@item.VentaContado.ToString("N2")
                                        </strong>

                                    </div>


                                    <div class="d-flex justify-content-between">

                                        <span class="text-muted">
                                            Abonos recibidos
                                        </span>

                                        <strong>
                                            $@item.Abonado.ToString("N2")
                                        </strong>

                                    </div>

                                </div>


                                <!-- ================================================= -->
                                <!-- RESUMEN DE CAJA -->
                                <!-- ================================================= -->

                                <div class="border-top mt-3 pt-3">

                                    <h6 class="fw-bold mb-3">

                                        <i class="bi bi-cash-stack me-2"></i>

                                        Resumen de caja

                                    </h6>


                                    <div class="d-flex justify-content-between mb-2">

                                        <span class="text-muted">
                                            Monto esperado
                                        </span>

                                        <strong class="text-primary">

                                            $@item.Monto.ToString("N2")

                                        </strong>

                                    </div>


                                    <div class="d-flex justify-content-between">

                                        <span class="text-muted">
                                            Dinero contado
                                        </span>

                                        <strong>

                                            $@item.MontoCuadrado.ToString("N2")

                                        </strong>

                                    </div>

                                </div>


                                <!-- ================================================= -->
                                <!-- RESULTADO -->
                                <!-- ================================================= -->

                                <div class="mt-3 p-3 rounded bg-light text-center">

                                    @if (diferencia < 0)
                                    {
                                        <small class="text-muted">
                                            Diferencia
                                        </small>

                                        <div class="fs-5 fw-bold text-danger">

                                            -$@Math.Abs(diferencia).ToString("N2")

                                        </div>
                                    }
                                    else if (diferencia > 0)
                                    {
                                        <small class="text-muted">
                                            Diferencia
                                        </small>

                                        <div class="fs-5 fw-bold text-warning-emphasis">

                                            +$@diferencia.ToString("N2")

                                        </div>
                                    }
                                    else
                                    {
                                        <small class="text-muted">
                                            Diferencia
                                        </small>

                                        <div class="fs-5 fw-bold text-success">

                                            $0.00

                                        </div>
                                    }

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- ACCIONES -->
                            <!-- ================================================= -->

                            <div class="card-footer bg-white border-0 pt-0 pb-3">

                                @if (Role == "Admin")
                                {
                                    <div class="d-grid gap-2 d-sm-flex">

                                        <button @onclick="async () => { await Seleccionar(item.Id); }"
                                                class="btn btn-outline-primary flex-fill">

                                            <i class="bi bi-pencil-square me-1"></i>

                                            Editar

                                        </button>


                                        <button @onclick="() => Eliminar(item)"
                                                class="btn btn-outline-danger flex-fill">

                                            <i class="bi bi-trash-fill me-1"></i>

                                            Eliminar

                                        </button>

                                    </div>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary w-100">

                                        <i class="bi bi-lock-fill me-1"></i>

                                        Acciones no permitidas

                                    </button>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>


            <!-- ================================================= -->
            <!-- TABLA EXCLUSIVA PARA IMPRESIÓN -->
            <!-- ================================================= -->

            <div class="d-none d-print-block">

                <table class="table table-bordered table-sm align-middle">

                    <thead>

                        <tr>

                            <th>Fecha</th>

                            <th>Cajero</th>

                            <th>Crédito</th>

                            <th>Contado</th>

                            <th>Abonado</th>

                            <th>Esperado</th>

                            <th>Contado</th>

                            <th>Resultado</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in CajasFiltradas)
                        {
                            var diferencia = item.MontoCuadrado - item.Monto;

                            <tr>

                                <td>
                                    @item.Fecha.ToString("dd/MM/yyyy hh:mm tt")
                                </td>

                                <td>
                                    @item.Cashier.Nombre
                                    @item.Cashier.Apellidos
                                </td>

                                <td>
                                    $@item.VentaCredito.ToString("N2")
                                </td>

                                <td>
                                    $@item.VentaContado.ToString("N2")
                                </td>

                                <td>
                                    $@item.Abonado.ToString("N2")
                                </td>

                                <td>
                                    $@item.Monto.ToString("N2")
                                </td>

                                <td>
                                    $@item.MontoCuadrado.ToString("N2")
                                </td>

                                <td>

                                    @if (diferencia < 0)
                                    {
                                        <span>
                                            Faltante:
                                            -$@Math.Abs(diferencia).ToString("N2")
                                        </span>
                                    }
                                    else if (diferencia > 0)
                                    {
                                        <span>
                                            Sobrante:
                                            +$@diferencia.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Cuadrada: $0.00
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        }

    </div>
    
    <div class="modal" style="display: @(ShowConfirmation ? "block" : "none"); background-color: rgba(0, 0, 0, 0.5);" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg rounded-4">
                <div class="modal-header bg-light border-0">
                    <h5 class="modal-title text-dark fw-bold">¿Estás seguro?</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="OpenClosedConfirmation"></button>
                </div>
                <div class="modal-body text-center">
                    <p class="mb-0">Esta acción no se puede deshacer. ¿Deseas continuar?</p>
                </div>
                <div class="modal-footer justify-content-center border-0">
                    <button class="btn btn-success px-4"
                            @onclick="async () => {
                                await Eliminar(caja);
                                OpenClosedConfirmation();
                            }">
                        <i style="font-size: 15px;" class="fw-bold">🗑️</i> Sí, eliminar
                    </button>
                    <button class="btn btn-outline-secondary px-4"
                            @onclick="OpenClosedConfirmation">
                        <i style="font-size: 15px;" class="fw-bold">✖️</i> Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public string TituloForm => request.Id == 0 ? 
    "Cuadrar Caja" : "Modificar cuadre";
    
    public List<FacturaResponse> Facturas { get; set; } = new();
    public List<UsuarioResponse> Cajeros { get; set; } = new();
    public List<PagoResponse> Pagos { get; set; } = new();
    public List<CuadrarCajaResponse> Cajas { get; set; } = new();
    public List<CuadrarCajaResponse> CajasFiltradas { get; set; } = new();

    public int? FiltroMes { get; set; } = null;

    public int? FiltroAno { get; set; } = null;

    public int AnoActual => DateTime.Now.Year;

    public List<int> AnosDisponibles =>
        Cajas
            .Select(c => c.Fecha.Year)
            .Distinct()
            .OrderByDescending(a => a)
            .ToList();
    public CuadrarCajaResponse caja { get; set; } = new();
    public CuadrarCajaRequest request { get; set; } = new();
    public string Filtro { get; set; } = "";
    public string Cashier { get; set; } = "";
    public string UserId = "";
    public string Role { get; set; } = "";
    public bool showCard { get; set; } = false;
    public bool ShowConfirmation { get; set; } = false;
    public decimal DineroEnCaja = 0;

    void FiltrarCajas()
    {
        IEnumerable<CuadrarCajaResponse> resultado = Cajas;

        // Filtrar por año
        if (FiltroAno.HasValue)
        {
            resultado = resultado
                .Where(c => c.Fecha.Year == FiltroAno.Value);
        }

        // Filtrar por mes
        if (FiltroMes.HasValue)
        {
            resultado = resultado
                .Where(c => c.Fecha.Month == FiltroMes.Value);
        }

        CajasFiltradas = resultado
            .OrderByDescending(c => c.Fecha)
            .ToList();
    }
    void LimpiarFiltros()
    {
        FiltroMes = null;
        FiltroAno = null;

        FiltrarCajas();
    }
    
    private string GetTotalClass(decimal total)
    {
        if (total < request.Monto)
        {
            return "bg-danger";
        }
        else if (total > request.Monto)
        {
            return "bg-warning";
        }
        else
        {
            return "bg-success";
        }
    }
    private string GetTotalClass2(decimal total, decimal dineroEnCaja)
    {
        if (total < dineroEnCaja)
        {
            return "bg-danger";
        }
        else if (total > dineroEnCaja)
        {
            return "bg-warning";
        }
        else
        {
            return "bg-success";
        }
    }
    void ShowCard()
    {
        showCard = true;
        request.Monto = DineroEnCaja;
    }
