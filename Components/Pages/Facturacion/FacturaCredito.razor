    private int mesSeleccionado = DateTime.Now.Month;
    private string FiltroAno { get; set; } = "";
    private string FiltroMes { get; set; } = "";

    private List<int> AnosDisponibles => Facturas
        .Where(f => f.TypePayment == "2")
        .Select(f => f.Fecha.Year)
        .Distinct()
        .OrderByDescending(a => a)
        .ToList();

    // Lista de años disponibles
    private List<int> AniosDisponibles => Facturas
        .Where(f => f.TypePayment == "2")
        .Select(f => f.Fecha.Year)
        .Distinct()
        .OrderByDescending(a => a)
        .ToList();


    // Facturas filtradas por ESTADO + PERÍODO
    private List<FacturaResponse> FacturasFiltradas => Facturas
    .Where(f =>
        // SOLO FACTURAS A CRÉDITO
        f.TypePayment == "2"

        // FILTRO PENDIENTES / PAGADAS
        && (
            (mostrarPendientes && f.SaldoPendiente > 0) ||
            (mostrarPagadas && f.SaldoPendiente == 0)
        )

        // FILTRO POR AÑO
        && (
            string.IsNullOrEmpty(FiltroAno) ||
            f.Fecha.Year.ToString() == FiltroAno
        )

        // FILTRO POR MES
        && (
            string.IsNullOrEmpty(FiltroMes) ||
            f.Fecha.Month.ToString() == FiltroMes
        )
    )
    .OrderByDescending(f => f.Fecha)
    .ToList();

