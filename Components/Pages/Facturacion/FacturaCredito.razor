    // Total de abonos realizados en las facturas filtradas
    private decimal AbonosTotalFiltrado => FacturasFiltradas
        .Sum(f => 
            Pagos
                .Where(p => p.FacturaID == f.Id)
                .Sum(p => (decimal)p.MontoPagado)
        );


    // Saldo pendiente de las facturas filtradas
    private decimal SaldoPendienteFiltrado => FacturasFiltradas
        .Sum(f => f.SaldoPendiente);


