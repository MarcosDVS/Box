@page "/cuadre"
@attribute [Authorize]

<style>
    /* Estilo para el contenedor de la tabla */
    .table-container {
        margin-top: 20px;
    }

    /* Estilo para el cuerpo de la tarjeta */
    .card-body {
        padding: 20px;
    }

    /* Estilo para centrar el texto en las celdas de la tabla */
    .table th, .table td {
        text-align: center;
    }
</style>



<div class="row">
    <div class="col-12">
        <h1 class="d-none d-print-block text-center">Listado de cuadres</h1>
    </div>
</div>


@if (showCard)
{
    <div class="card col-12">
            <div>
                <div class="card-header">
                    <h5 class="title d-print-none text-uppercase"><b>@TituloForm</b></h5>
                    <h5 class="title text-dark d-none d-print-block"><b>Detalles del Cuadre</b></h5>
                </div>

                <EditForm Model="request" OnValidSubmit="Send">

                    <div class="card-body py-3">

                        <!-- RESUMEN DE CAJA -->
                        <div class="row g-2 mb-3">

                            <!-- CAJERO -->
                            <div class="col-md-4">
                                <div class="border rounded px-3 py-2 h-100">
                                    <small class="text-muted d-block">
                                        👤 Cajero
                                    </small>

                                    @if (request.Id > 0)
                                    {
                                        <select class="form-select form-select-sm"
                                                required
                                                @bind="request.CajeroId">

                                            <option disabled selected value="">
                                                Selecciona un cajero
                                            </option>

                                            @foreach (var item in Cajeros)
                                            {
                                                <option value="@item.Id">
                                                    @item.Nombre @item.Apellidos
                                                </option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <strong>@Cashier</strong>
                                    }
                                </div>
                            </div>


                            <!-- DINERO EN CAJA -->
                            <div class="col-md-4">
                                <div class="border rounded px-3 py-2 h-100">
                                    <small class="text-muted d-block">
                                        💰 Dinero en caja
                                    </small>

                                    @if (request.Id > 0)
                                    {
                                        <strong class="fs-5">
                                            $@request.Monto.ToString("N2")
                                        </strong>
                                    }
                                    else
                                    {
                                        <strong class="fs-5">
                                            $@DineroEnCaja.ToString("N2")
                                        </strong>
                                    }
                                </div>
                            </div>


                            <!-- MONTO CUADRADO -->
                            <div class="col-md-4">
                                <div class="border rounded px-3 py-2 h-100">
                                    <small class="text-muted d-block">
                                        🧾 Monto cuadrado
                                    </small>

                                    @if (request.Id > 0)
                                    {
                                        <strong class="fs-5 @(GetTotalClass(request.Total))">
                                            $@request.Total.ToString("N2")
                                        </strong>
                                    }
                                    else
                                    {
                                        <strong class="fs-5 @(GetTotalClass2(request.Total, DineroEnCaja))">
                                            $@request.Total.ToString("N2")
                                        </strong>
                                    }
                                </div>
                            </div>

                        </div>


                        <!-- CONTEO DE EFECTIVO -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <strong>💵 Conteo de efectivo</strong>
                                <small class="text-muted ms-2">
                                    Ingresa la cantidad de billetes.
                                </small>
                            </div>
                        </div>


                        <!-- BILLETES -->
                        <div class="row g-2">

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$1</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.One"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$5</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.Five"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$10</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.Ten"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$25</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.TwentyFive"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$50</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.Fifty"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>


                        </div>

                        <div class="row g-2">
                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$100</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.OneHundred"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$200</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.TwoHundred"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$500</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.FiveHundred"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$1,000</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.OneThousand"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$2,000</span>
                                    <input type="number"
                                        class="form-control"
                                        @bind-value="request.TwoThousand"
                                        min="0"
                                        placeholder="0" />
                                </div>
                            </div>

                        </div>

                        <!-- RESULTADO -->
                        <div class="row g-2 mt-3 align-items-center">

                            <div class="col-md-8">
                                <div class="border rounded px-3 py-2 d-flex justify-content-between align-items-center bg-light">

                                    <strong>
                                        📊 Diferencia de caja
                                    </strong>

                                    @if (request.Id > 0)
                                    {
                                        <strong class="fs-5 @(GetTotalClass(request.Total))">
                                            $@((request.Total - request.Monto).ToString("N2"))
                                        </strong>
                                    }
                                    else
                                    {
                                        <strong class="fs-5 @(GetTotalClass2(request.Total, DineroEnCaja))">
                                            $@((request.Total - request.Monto).ToString("N2"))
                                        </strong>
                                    }

                                </div>
                            </div>


                            <!-- BOTONES -->
                            <div class="col-md-4">
                                <div class="d-flex justify-content-end gap-2">

                                    <button type="submit"
                                            class="btn btn-success btn-sm px-4">
                                        💾 Guardar
                                    </button>

                                    <button type="button"
                                            class="btn btn-secondary btn-sm px-4"
                                            @onclick="Clear">
                                        ❌ Cerrar
                                    </button>

                                </div>
                            </div>

                        </div>

                    </div>

                </EditForm>

                
            </div>
    </div>
}
else
{
    <div class="table-container">
        <div class="card col-12">
            <div class="card-body">
                <div class="row">
                    <div class="col-11">
                        <!-- Button trigger modal -->
                        <button class="btn btn-outline-success d-print-none" @onclick="ShowCard">
                            <span aria-hidden="true"><i style="font-size: 20px;" class="fw-bold">➕</i></span>
                        </button>
                        <button class="btn btn-outline-secondary d-print-none text-black" 
                            @onclick="async ()=>{await PrintPageAsync();}">
                            <span aria-hidden="true"><i style="font-size: 20px;" class="fw-bold">🖨</i></span>
                        </button>
                    </div>
                    <div class="col-1">
                        <button class="btn btn-outline-danger d-print-none" @onclick="Back">
                            <i style="font-size: 20px;" class="fw-bold">⬅</i>
                        </button>
                    </div>
                </div>
                
                <div class="row mt-2">
                    <div class="col-8"></div>
                    <div class="col-4">
                        <div class="input-group d-print-none">
                            <input type="text" class="form-control border-0 border-bottom" 
                            placeholder="Buscar por nombre" @bind="Filtro">
                            <button class="btn btn-outline-secondary border-0 border-bottom" 
                                type="button" id="button-addon2" @onclick="()=>CargarCajas()">
                                <i style="font-size: 20px;" class="fw-bold">🔎</i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="row mt-2">

                    @if (Cajas.Count == 0)
                    {
                        <div class="col-12 mt-3">
                            <div class="alert alert-light border text-center">
                                <div style="font-size: 30px;">🏦</div>

                                <h5 class="text-muted mb-1">
                                    No hay cajas registradas
                                </h5>

                                <small class="text-muted">
                                    Aún no se han realizado arqueos de caja.
                                </small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col-12">
                            <div class="table-responsive">

                                <table class="table table-hover align-middle">

                                    <!-- ENCABEZADO -->
                                    <thead class="table-light">
                                        <tr>

                                            <th>📅 Fecha</th>

                                            <th>👤 Cajero</th>

                                            <th>💰 Movimientos</th>

                                            <th>🧾 Caja</th>

                                            <th>📊 Resultado</th>

                                            <th class="text-center d-print-none">
                                                Acciones
                                            </th>

                                        </tr>
                                    </thead>


                                    <tbody>

                                        @foreach (var item in Cajas)
                                        {
                                            var diferencia = item.MontoCuadrado - item.Monto;

                                            <tr>

                                                <!-- FECHA -->
                                                <td>
                                                    <div>
                                                        <strong>
                                                            @item.Fecha.ToString("dd/MM/yyyy")
                                                        </strong>
                                                    </div>

                                                    <small class="text-muted">
                                                        @item.Fecha.ToString("hh:mm tt")
                                                    </small>
                                                </td>


                                                <!-- CAJERO -->
                                                <td>
                                                    <div class="d-flex align-items-center">

                                                        <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center me-2"
                                                            style="width: 38px; height: 38px;">
                                                            👤
                                                        </div>

                                                        <div>
                                                            <strong>
                                                                @item.Cashier.Nombre
                                                                @item.Cashier.Apellidos
                                                            </strong>

                                                            <div>
                                                                <small class="text-muted">
                                                                    Cajero
                                                                </small>
                                                            </div>
                                                        </div>

                                                    </div>
                                                </td>


                                                <!-- MOVIMIENTOS -->
                                                <td>

                                                    <div class="small">

                                                        <div class="d-flex justify-content-between">
                                                            <span class="text-muted">
                                                                Crédito:
                                                            </span>

                                                            <strong>
                                                                $@item.VentaCredito.ToString("N2")
                                                            </strong>
                                                        </div>


                                                        <div class="d-flex justify-content-between">
                                                            <span class="text-muted">
                                                                Contado:
                                                            </span>

                                                            <strong>
                                                                $@item.VentaContado.ToString("N2")
                                                            </strong>
                                                        </div>


                                                        <div class="d-flex justify-content-between">
                                                            <span class="text-muted">
                                                                Abonado:
                                                            </span>

                                                            <strong>
                                                                $@item.Abonado.ToString("N2")
                                                            </strong>
                                                        </div>

                                                    </div>

                                                </td>


                                                <!-- CAJA -->
                                                <td>

                                                    <div class="small">

                                                        <div>
                                                            <span class="text-muted">
                                                                Esperado
                                                            </span>

                                                            <div>
                                                                <strong class="text-primary">
                                                                    $@item.Monto.ToString("N2")
                                                                </strong>
                                                            </div>
                                                        </div>

                                                        <div class="mt-1">
                                                            <span class="text-muted">
                                                                Contado
                                                            </span>

                                                            <div>
                                                                <strong class="text-dark">
                                                                    $@item.MontoCuadrado.ToString("N2")
                                                                </strong>
                                                            </div>
                                                        </div>

                                                    </div>

                                                </td>


                                                <!-- RESULTADO -->
                                                <td>

                                                    @if (diferencia < 0)
                                                    {
                                                        <span class="badge bg-danger">
                                                            🔻 Faltante
                                                        </span>

                                                        <div class="text-danger fw-bold mt-1">
                                                            $@Math.Abs(diferencia).ToString("N2")
                                                        </div>
                                                    }
                                                    else if (diferencia > 0)
                                                    {
                                                        <span class="badge bg-warning text-dark">
                                                            🔺 Sobrante
                                                        </span>

                                                        <div class="text-warning-emphasis fw-bold mt-1">
                                                            $@diferencia.ToString("N2")
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">
                                                            ✅ Cuadrada
                                                        </span>

                                                        <div class="text-success fw-bold mt-1">
                                                            $0.00
                                                        </div>
                                                    }

                                                </td>


                                                <!-- ACCIONES -->
                                                <td class="text-center d-print-none">

                                                    @if (Role == "Admin")
                                                    {
                                                        <div class="btn-group">

                                                            <button @onclick="async () => { await Seleccionar(item.Id); }"
                                                                    class="btn btn-outline-primary"
                                                                    title="Editar arqueo">
                                                                <i class="bi bi-pencil-square"></i>
                                                            </button>

                                                            <button @onclick="() => Eliminar(item)"
                                                                    class="btn btn-outline-danger"
                                                                    title="Eliminar arqueo">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>

                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="btn-group">

                                                            <button class="btn btn-outline-secondary"
                                                                    title="Edición no permitida">
                                                                <i class="bi bi-lock-fill"></i>
                                                            </button>

                                                            <button class="btn btn-outline-secondary"
                                                                    title="Eliminación no permitida">
                                                                <i class="bi bi-lock-fill"></i>
                                                            </button>

                                                        </div>
                                                    }

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        </div>
                    }

                </div>

                
            </div>
        </div>
    </div>
    
    <div class="modal" style="display: @(ShowConfirmation ? "block" : "none"); background-color: rgba(0, 0, 0, 0.5);" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg rounded-4">
                <div class="modal-header bg-light border-0">
                    <h5 class="modal-title text-dark fw-bold">¿Estás seguro?</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="OpenClosedConfirmation"></button>
                </div>
                <div class="modal-body text-center">
                    <p class="mb-0">Esta acción no se puede deshacer. ¿Deseas continuar?</p>
                </div>
                <div class="modal-footer justify-content-center border-0">
                    <button class="btn btn-success px-4"
                            @onclick="async () => {
                                await Eliminar(caja);
                                OpenClosedConfirmation();
                            }">
                        <i style="font-size: 15px;" class="fw-bold">🗑️</i> Sí, eliminar
                    </button>
                    <button class="btn btn-outline-secondary px-4"
                            @onclick="OpenClosedConfirmation">
                        <i style="font-size: 15px;" class="fw-bold">✖️</i> Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public string TituloForm => request.Id == 0 ? 
    "Cuadrar Caja" : "Modificar cuadre";
    
    public List<FacturaResponse> Facturas { get; set; } = new();
    public List<UsuarioResponse> Cajeros { get; set; } = new();
    public List<PagoResponse> Pagos { get; set; } = new();
    public List<CuadrarCajaResponse> Cajas { get; set; } = new();
    public CuadrarCajaResponse caja { get; set; } = new();
    public CuadrarCajaRequest request { get; set; } = new();
    public string Filtro { get; set; } = "";
    public string Cashier { get; set; } = "";
    public string UserId = "";
    public string Role { get; set; } = "";
    public bool showCard { get; set; } = false;
    public bool ShowConfirmation { get; set; } = false;
    public decimal DineroEnCaja = 0;

    private string GetTotalClass(decimal total)
    {
        if (total < request.Monto)
        {
            return "bg-danger";
        }
        else if (total > request.Monto)
        {
            return "bg-warning";
        }
        else
        {
            return "bg-success";
        }
    }
    private string GetTotalClass2(decimal total, decimal dineroEnCaja)
    {
        if (total < dineroEnCaja)
        {
            return "bg-danger";
        }
        else if (total > dineroEnCaja)
        {
            return "bg-warning";
        }
        else
        {
            return "bg-success";
        }
    }
    void ShowCard()
    {
        showCard = true;
        request.Monto = DineroEnCaja;
    }
    void OpenClosedConfirmation()
    {
        ShowConfirmation = !ShowConfirmation;
        StateHasChanged();
    }
    //Metodos Para confirmar las perdidas
    void ShowQuestion(CuadrarCajaResponse seletedItem)
    {
        OpenClosedConfirmation();
        caja = seletedItem; // Usa la variable de instancia en lugar de declarar una nueva.
    }
    void Back()
    {
        urlHelper.NavigateTo("inicio");
    }
    DateTime ultimoCuadreFecha;
    void CashInBox()
    {
        // Filtrar las facturas y pagos posteriores al último cuadre de caja
        var facturasPosteriores = Facturas.Where(f => f.Fecha > ultimoCuadreFecha);
        var pagosPosteriores = Pagos.Where(p => p.Fecha > ultimoCuadreFecha);

        // Calcular el monto en caja sumando las facturas y los pagos posteriores al último cuadre
        var Contado = facturasPosteriores
            .Where(c => c.TypePayment == "1" && c.SaldoPendiente <= 0)
            .Sum(c => c.SubTotal - c.TotalDesc);

        var Credito = facturasPosteriores
            .Where(c => c.TypePayment == "2" && c.SaldoPendiente > 0)
            .Sum(c => c.SubTotal - c.TotalDesc);

        var Pago = (decimal)pagosPosteriores
            .Sum(c => c.MontoPagado);

        DineroEnCaja = Contado + Pago;
    }

    async Task ConsultarCashier()
    {
        var resultado = await usuarioServices.Consultar(Filtro);
        if (resultado.Success)
        {
            Cajeros = resultado.Data!;
        }
        StateHasChanged();
    }
    async Task Consultar()
    {
        var resultado = await facturaServices.Consultar(Filtro);
        if (resultado.Success)
        {
            Facturas = resultado.Data?.OrderByDescending(f => f.Fecha).ToList() ?? new List<FacturaResponse>();
        }
        StateHasChanged();
    }
    async Task CargarPagos()
    {
        var resultado =
        await pagoServices.Consultar(Filtro);
        if (resultado.Success)
        {
            Pagos = resultado.Data!;
        }
    }
    async Task CargarCajas()
    {
        var resultado =
        await cuadrarCajaServices.Consultar(Filtro);
        if (resultado.Success)
        {
            Cajas = resultado.Data!;
        }

        // Verificar si hay algún cuadre de caja en la lista
        if (Cajas.Any())
        {
            // Ordenar la lista de Cajas por fecha en orden descendente
            Cajas = Cajas.OrderByDescending(c => c.Fecha).ToList();
            
            // Tomar la fecha del primer elemento de la lista (el más reciente)
            ultimoCuadreFecha = Cajas.First().Fecha;
        }
        else
        {
          ultimoCuadreFecha = DateTime.MinValue; // Si no hay cajas, establecer una fecha mínima
        }
    }
    protected override async Task OnInitializedAsync()
    {
        // Obtener el estado de autenticación
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;

        // Verifica si el usuario está autenticado
        if (user.Identity.IsAuthenticated)
        {
            // Extrae los valores de los reclamos y asigna las propiedades
            Role = user.FindFirst(ClaimTypes.Role)?.Value ?? "";
            Cashier = user.FindFirst(ClaimTypes.GivenName)?.Value ?? "";
            UserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        }
        await Consultar();
        await ConsultarCashier();
        await CargarPagos();
        await CargarCajas();
        CashInBox();
        

    }

    void Clear()
    {
        request  = new CuadrarCajaRequest();
        showCard = false;
    }
    
    public async Task Send()
    {
        request.Fecha = DateTime.Now;
        request.MontoCuadrado = request.Total;
        @* request.Cajero = Cashier; *@
        request.CajeroId = Convert.ToInt32(UserId);
        
        if(request.Id == 0)
        {
            //Debo registrar el contacto..
            var r = await cuadrarCajaServices.Crear(request);
            if (r.Success)
            {
                Clear();
                await CargarCajas();
                CashInBox();
                StateHasChanged();
            }
        }
        else
        {
            //Debo solicitar modificar el contacto...
            var r = await cuadrarCajaServices.Modificar(request);
            if (r.Success)
            {
                Clear();
                await CargarCajas();
                CashInBox();
                StateHasChanged();
            }
        }
    }
    
    async Task Seleccionar(int Id)
    {
        request = Cajas
        .Where(c => c.Id == Id)
        .Select(c => c.ToRequest())
        .FirstOrDefault() ?? new CuadrarCajaRequest();
        showCard = true;

    }
    public async Task Eliminar(CuadrarCajaResponse item)
    {
        var resultado = await cuadrarCajaServices.Eliminar(item.ToRequest());
        if (resultado.Success)
        {
            await CargarCajas();
            CashInBox();
            StateHasChanged();
        }
    }

    private async Task PrintPageAsync()
    {
        // Llama a la función JavaScript para imprimir la página
